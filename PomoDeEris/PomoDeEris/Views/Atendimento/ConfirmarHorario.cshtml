<head>
    <link href="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/styles/index.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/index.js" defer></script>
    <script src="~/js/calendario.js" defer> </script>
    <link rel="stylesheet" href="~/css/atendimento.css" />
</head>
<section class="agendamento-wrapper">

    <header class="agendamento-titulo">
        <span class="agendamento-subtitulo">AGENDE SEU HORÁRIO</span>
        <h1>Selecione a data e o horário</h1>
        <p>Escolha o dia que preferir e depois o horário disponível para o seu atendimento.</p>
    </header>

    <form asp-controller="Atendimento" asp-action="Agendar" method="post" id="formularioAgendamento">
        <input type="hidden" id="horarioCompleto" name="horario" />
        <input type="hidden" id="dataSelecionada" />

        <div class="agendamento-conteudo">

            <section class="cartao-calendario">
                <div id="calendario"></div>
            </section>

            <section class="cartao-horarios">

                <div class="horarios-cabecalho">
                    <div class="icone-relogio">&#9719;</div>
                    <div>
                        <h2>Horários disponíveis</h2>
                        <p id="textoData">Selecione uma data no calendário</p>
                    </div>
                </div>

                <div class="horarios-grade" id="listaHorarios">

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="09:00" required />
                        <span>09:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="10:00" />
                        <span>10:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="11:00" />
                        <span>11:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="12:00" />
                        <span>12:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="13:00" />
                        <span>13:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="14:00" />
                        <span>14:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="15:00" />
                        <span>15:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="16:00" />
                        <span>16:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="17:00" />
                        <span>17:00</span>
                    </label>

                    <label class="opcao-horario">
                        <input type="radio" name="Horario" value="18:00" />
                        <span>18:00</span>
                    </label>

                </div>

                <button type="submit" class="botao-confirmar">
                    Confirmar agendamento
                    <span aria-hidden="true">&#8594;</span>
                </button>

            </section>

        </div>
    </form>

</section>
