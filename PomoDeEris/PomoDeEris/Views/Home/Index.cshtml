@model IEnumerable<PomoDeEris.Models.Pacote>

@{
    ViewData["Title"] = "Clínica Estética";
}
@section Styles {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
}

<!-- HERO -->
<section class="banner">
  <div class="banner-texto">
    <p class="banner-chamada">Desde sempre, a mais bela</p>
    <h1 class="banner-titulo">Beleza que transforma,<br>cuidado que <span>conquista.</span></h1>
    <p class="banner-descricao">
      Tratamentos estéticos faciais, corporais e injetáveis, escolhidos com critério clínico
      e agendados em poucos cliques — para a beleza que só pertence a você.
    </p>

    <form class="banner-busca" id="hero-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="text" placeholder="Buscar tratamento — ex: bronzeamento, manicure...">
      <button type="submit">Buscar</button>
    </form>

    <div class="banner-botoes">
      <a href="#tratamentos" class="btn btn-principal">Ver tratamentos</a>
      <a href="#contato" class="btn btn-contorno">Agendar avaliação</a>
    </div>

    <div class="banner-numeros">
      <span>15 anos de experiência</span>
      <span class="ponto">•</span>
      <span>+20.000 atendimentos</span>
      <span class="ponto">•</span>
      <span>Profissionais certificados</span>
    </div>
  </div>

  <div class="banner-imagem">
    <div class="banner-moldura">
      <img src="~/images/logoPomoTransparente.png" alt="Pomo de Eris" class="banner-logo">
    </div>
  </div>
</section>


<!-- PROMOÇÃO -->
<section class="promocao" id="promocoes">
  <div class="promocao-icone">%</div>
  <div class="promocao-conteudo">
    <p class="promocao-chamada">Promoção de inverno</p>
    <h2 class="promocao-titulo">20% off em tratamentos faciais</h2>
    <p class="promocao-descricao">
      Aproveite o inverno para renovar a pele: hidratação profunda, limpeza clínica
      e protocolos faciais com condição especial por tempo limitado.
    </p>
    <a href="#tratamentos" class="btn btn-principal">Aproveitar oferta</a>
  </div>
  <div class="promocao-contagem" id="countdown">
    <div class="contagem-unidade"><span id="cd-days">67</span><label>dias</label></div>
    <div class="contagem-unidade"><span id="cd-hours">02</span><label>horas</label></div>
    <div class="contagem-unidade"><span id="cd-min">06</span><label>min</label></div>
    <div class="contagem-unidade"><span id="cd-sec">48</span><label>seg</label></div>
  </div>
</section>


<!-- DIFERENCIAIS -->
<section class="diferenciais">
  <div class="diferencial">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6z"/></svg>
    <div>
      <h3>Profissionais certificados</h3>
      <p>Equipe clínica com formação e atualização constante.</p>
    </div>
  </div>
  <div class="diferencial">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
    <div>
      <h3>Produtos originais</h3>
      <p>Insumos importados e rastreáveis, sem atalhos.</p>
    </div>
  </div>
  <div class="diferencial">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/><circle cx="12" cy="12" r="3"/></svg>
    <div>
      <h3>Ambiente exclusivo</h3>
      <p>Atendimento privado, discreto e sem pressa.</p>
    </div>
  </div>
</section>


<!-- TRATAMENTOS -->
<section class="tratamentos" id="tratamentos">
  <div class="secao-topo">
    <h2>Tratamentos em destaque</h2>
    <p class="secao-subtitulo">Cuidados que falam por si</p>
    <p class="secao-descricao">
      Selecionados pela nossa equipe clínica, com preços transparentes e agendamento em poucos cliques.
    </p>
  </div>

  <div class="filtros" id="filters">
    <button class="btn-filtro active" data-filter="todos">Todos</button>
    <button class="btn-filtro" data-filter="facial">Facial</button>
    <button class="btn-filtro" data-filter="corporal">Corporal</button>
    <button class="btn-filtro" data-filter="relaxamento">Relaxamento</button>
  </div>

  <div class="grade-tratamentos" id="treatment-grid">
       <!-- Gera os pacotes a partir do banco -->
        @foreach(var item in Model)
        {
        <article class="cartao-tratamento" data-id="massagem-relaxante">
                <div class="cartao-imagem">
                  <img src="@item.Imagem" alt="Pacote Massagem Relaxante">
                  <span class="cartao-selo">Inverno −20%</span>
                </div>
                <div class="cartao-corpo">
                  <h3 class="cartao-nome">@item.Nome</h3>
                  <p class="cartao-descricao">@item.Descricao</p>
                  <span class="cartao-duracao">⏱ 60 min</span>
                  <div class="cartao-rodape">
                    <div class="cartao-preco-area">
                      <span class="cartao-preco-rotulo"></span>
                      <span class="cartao-preco">
                       R$ @item.Valor
                      </span>
                    </div>
                    @using(Html.BeginForm("AdicionarItem", "Carrinho", FormMethod.Post))
                    {

                    <input type="hidden" name="id" value=@item.IdPacote />
                    <button class="btn-agendar" type="submit">+ Agendar</button>

                    }
                  </div>
                </div>
            </article>
        }
    </div>
</section>


<!-- DEPOIMENTO -->
<section class="depoimento">
  <img src="~/images/fotoDaCliente.png" alt="Camila R." class="depoimento-foto">
  <div class="depoimento-conteudo">
    <blockquote>
      "Marquei pelo site em poucos minutos e o atendimento foi exatamente como esperava:
      cuidadoso, transparente e sem pressa. Saí de lá sentindo que o veredito, finalmente, era meu."
    </blockquote>
    <cite>— Camila R., cliente desde 2023</cite>
  </div>
</section>

<!-- FINAL -->
<section class="chamada-final" id="sobre">
  <p class="chamada-final-subtitulo">Pronta para começar?</p>
  <h2 class="chamada-final-titulo">O seu veredito de beleza<br>começa com uma conversa.</h2>
  <a href="#contato" class="btn btn-escuro">Agende agora</a>
</section>





<!-- PAINEL LATERAL DO CARRINHO -->
<aside class="painel-carrinho" id="cart-panel">
  <div class="painel-topo">
    <h3>Resumo do agendamento</h3>
    <button id="cart-close" aria-label="Fechar">✕</button>
  </div>
  <div class="painel-corpo" id="cart-body">
    <div class="carrinho-vazio" id="cart-empty">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
      <p>Sua agenda está vazia.</p>
      <span>Escolha um tratamento para começar.</span>
    </div>
    <ul class="itens-carrinho" id="cart-items"></ul>
  </div>
  <div class="painel-rodape" id="cart-footer" hidden>
    <div class="carrinho-total">
      <span>Total</span>
      <strong id="cart-total-value">R$ 0</strong>
    </div>
    <a href="@Url.Action("carrinhoDeCompra", "Home")" class="btn btn-principal" id="go-to-cart">Ir para o carrinho</a>
  </div>
</aside>
<div class="carrinho-fundo" id="cart-overlay"></div>

<div class="toast" id="toast"></div>
