@model Cliente
@{
    Layout = null;
    ViewData["Title"] = "Cadastro";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pomo de Eris — Cadastrar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/sienna-accessibility/dist/sienna-accessibility.umd.js" async></script>
    <link rel="stylesheet" href="~/css/paginaDeLogin.css" asp-append-version="true">
</head>

<body>
<div class="pagina-login">

  <!-- LADO ESQUERDO -->
  <aside class="lado-esquerdo">
    <div class="lado-esquerdo-conteudo">
      <div class="marca">
        <h1 class="marca-nome">Pomo de Eris</h1>
        <img id="logo" src="~/images/logoPomoTransparente.png" alt="" class="marca-logo">
      </div>

      <blockquote class="marca-frase">
        “Beleza que transforma,<br>Cuidado que conquista”
      </blockquote>

      <p class="marca-slogan">
        Tratamentos estéticos personalizados, escolhidos e agendados em poucos cliques.
      </p>
    </div>

    <footer class="lado-esquerdo-rodape">© 2026 Pomo de Eris · Clínica Estética</footer>
  </aside>

  <!-- LADO DIREITO -->
  <main class="lado-direito">
    <a asp-action="Index" asp-controller="Home" class="link-voltar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      Voltar ao site
    </a>

    <div class="caixa-formulario">
      <p class="formulario-topo">Pomo de Eris</p>
      <h2 class="formulario-titulo">Cadastre-se</h2>
      <p class="formulario-subtitulo">Entre para gerenciar seus tratamentos e agendamentos.</p>

      <form id="login-form" method="post" asp-action="Cadastro">
         <p>@ViewData["MSG_E"]</p>  <!--estilizar dps-->

        <div class="grupo-campo">
            <label asp-for="CPF"></label>
            <div class="caixa-input">
                <svg class="icone-input" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <input asp-for="CPF" placeholder="000.000.000-00" autocomplete="off" class="input-campo" />
            </div>
            <span asp-validation-for="CPF" class="erro-campo"></span>
        </div>

        <div class="grupo-campo">
            <label asp-for="Nome"></label>
            <div class="caixa-input">
                <svg class="icone-input" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <input asp-for="Nome" placeholder="Seu nome completo" autocomplete="name" class="input-campo" />
            </div>
            <span asp-validation-for="Nome" class="erro-campo"></span>
        </div>

        <div class="grupo-campo">
            <label asp-for="Email"></label>
            <div class="caixa-input">
                <svg class="icone-input" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="M2 6l10 7 10-7" />
                </svg>
                <input asp-for="Email" type="email" placeholder="voce@email.com" autocomplete="email" class="input-campo" />
            </div>
            <span asp-validation-for="Email" class="erro-campo"></span>
        </div>

        <div class="grupo-campo">
            <label asp-for="Senha"></label>
            <div class="caixa-input">
                <svg class="icone-input" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3" y="11" width="18" height="10" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <input asp-for="Senha" placeholder="Digite sua senha" autocomplete="new-password" class="input-campo" />
            </div>
            <span asp-validation-for="Senha" class="erro-campo"></span>
        </div>

        <div class="grupo-campo">
            <label asp-for="Telefone"></label>
            <div class="caixa-input">
                <svg class="icone-input" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.09 5.18 2 2 0 0 1 5.08 3h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.63 2.6a2 2 0 0 1-.45 2.11L9.1 10.6a16 16 0 0 0 4.3 4.3l1.17-1.16a2 2 0 0 1 2.11-.45c.83.3 1.7.51 2.6.63A2 2 0 0 1 22 16.92z" />
                </svg>
                <input asp-for="Telefone" type="tel" placeholder="(11) 99999-9999" autocomplete="tel" class="input-campo" maxlength="11"/>
            </div>
            <span asp-validation-for="Telefone" class="erro-campo"></span>
        </div>

        <button type="submit" class="btn btn-principal" id="submit-btn">Cadastrar</button>

        <p class="texto-cadastro">Já tem uma conta?</p>
         <a class="btn btn-secundario" id="create-account-btn" asp-action="Login" asp-controller="Cliente">Login</a>

        <p class="termos">
          Ao continuar, você concorda com nossos
          <a href="#">Termos de uso</a> e <a href="#">Política de privacidade</a>.
        </p>
      </form>
    </div>
  </main>

</div>

<div class="toast" id="toast"></div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
