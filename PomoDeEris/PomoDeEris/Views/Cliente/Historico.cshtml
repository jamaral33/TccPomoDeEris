@using PomoDeEris.Libraries.Login
@model List<Atendimento>
@inject LoginCliente loginCliente;

@{
    ViewData["Title"] = "Histórico";
    var cliente = loginCliente.GetCliente();
}
@section Styles{
    <link rel="stylesheet" href="~/css/historico.css" asp-append-version="true">

}

<section class="pagina">

    <!-- Conteúdos principais -->
    <div class="conta">

    <aside class="menu-lateral">
        <h2 class="menu-lateral__nome">@cliente.Nome</h2>
        <p class="menu-lateral__desde">Desde @cliente.DataCadastro.ToString("dd/MM/yyyy")</p>

        <a asp-controller="Cliente" asp-action="Historico" class="menu-lateral__item">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            Histórico
        </a>
        <a asp-controller="Cliente" asp-action="Index" class="menu-lateral__item menu-lateral__item--ativo">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20l4-1 11-11-3-3L5 16l-1 4z" /></svg>
            Minhas informações
        </a>

        <form asp-controller="Cliente" asp-action="Logout" method="post">
            <button type="submit" class="botao botao--perigo">Sair da Conta</button>
        </form>
    </aside>

        <main>
            <h1 class="titulo">Meu histórico</h1>
            <p class="subtitulo">Acompanhe seus atendimentos e agende novamente em poucos cliques.</p>

            <div class="resumo">
                <div class="resumo-card">
                    <span class="resumo-rotulo">Atendimentos</span>
                    <span class="resumo-valor"></span>
                </div>
                <div class="resumo-card">
                    <span class="resumo-rotulo">Próximo agendamento</span>
                    <span class="resumo-valor"></span>
                </div>
                <div class="resumo-card">
                    <span class="resumo-rotulo">Total</span>
                    <span class="resumo-valor">R$</span>
                </div>
            </div>

            <div class="filtros">
                <span class="pill ativo">Todos</span>
                <span class="pill">Concluídos</span>
                <span class="pill">Agendados</span>
                <span class="pill">Cancelados</span>
            </div>

            <div class="lista">

                <div class="item">
                    <img class="item-img" src="" alt="">
                    <div>
                        <h3 class="item-nome">Pacote Massagem Relaxante</h3>
                        <p class="item-meta"></p>
                    </div>
                    <span class="item-preco">R$</span>
                </div>

                <div class="item">
                    <img class="item-img" src="" alt="">
                    <div>
                        <h3 class="item-nome">Procedimento, Pacote manicure</h3>
                        <p class="item-meta"></p>
                    </div>
                    <span class="item-preco">R$</span>
                    <div class="item-acao"></div>
                </div>

                <div class="item">
                    <img class="item-img" src="" alt="">
                    <div>
                        <h3 class="item-nome">Procedimentos de pelos faciais</h3>
                        <p class="item-meta"></p>
                    </div>
                    <span class="item-preco">R$</span>
                    <div class="item-acao"></div>
                </div>

                <div class="item">
                    <img class="item-img" src="" alt="">
                    <div>
                        <h3 class="item-nome">Pacote Relaxamento Hidro</h3>
                        <p class="item-meta"></p>
                    </div>
                    <span class="item-preco">R$</span>
                    <div class="item-acao"></div>
                </div>

                <div class="item">
                    <img class="item-img" src="" alt="">
                    <div>
                        <h3 class="item-nome">Pacote Micropigmentação</h3>
                    </div>
                    <span class="item-preco">R$</span>
                    <div class="item-acao"></div>
                </div>

            </div>
        </main>
    </div>

   </section>