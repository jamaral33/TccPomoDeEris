@using PomoDeEris.Libraries.Login
@model Cliente;
@inject LoginCliente loginCliente;

@{
    ViewData["Title"] = "Histórico";
    List<Atendimento>  atendimentos = ViewBag.Atendimentos;
    string filtroSelecionado = ViewBag.FiltroSelecionado;
    DateTime proximaConsulta = ViewBag.ProximaConsulta;
    int QtdConsultas = ViewBag.QtdConsultas;
    double totalGasto = ViewBag.QuantiaGasta;
}
@section Styles{
    <link rel="stylesheet" href="~/css/historico.css" asp-append-version="true">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
}

<section class="pagina">

    <!-- Conteúdos principais -->
    <div class="conta">

    <aside class="menu-lateral">
        <h2 class="menu-lateral__nome">@Model.Nome</h2>
        <p class="menu-lateral__desde">Desde @Model.DataCadastro.ToString("dd/MM/yyyy")</p>

        <a asp-controller="Cliente" asp-action="Historico" class="menu-lateral__item menu-lateral__item--ativo">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            Histórico
        </a>
        <a asp-controller="Cliente" asp-action="Index" class="menu-lateral__item">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20l4-1 11-11-3-3L5 16l-1 4z" /></svg>
            Minhas informações
        </a>

        <form asp-controller="Cliente" asp-action="Logout" method="post">
            <button type="submit" class="botao botao--perigo">Sair da Conta</button>
        </form>
    </aside>

        <main>
            <h1 class="titulo">Meu histórico</h1>
            <p class="subtitulo">Acompanhe seus atendimentos e agende novamente em poucos cliques.</p>

            <div class="resumo">
                <div class="resumo-card">
                    <span class="resumo-rotulo">Atendimentos</span>
                    <span class="resumo-valor">@QtdConsultas</span>
                </div>
                <div class="resumo-card">
                    <span class="resumo-rotulo">Próximo agendamento</span>
                    <span class="resumo-valor">@(proximaConsulta == DateTime.MinValue ? "Nenhuma consulta" : proximaConsulta.ToString("dd/MM/yyyy"))</span>
                </div>
                <div class="resumo-card">
                    <span class="resumo-rotulo">Total</span>
                    <span class="resumo-valor">R$@totalGasto</span>
                </div>
            </div>

        <div class="filtros">

            <a asp-action="Historico" asp-controller="Cliente" asp-route-filtro="" class="pill @(string.IsNullOrWhiteSpace(filtroSelecionado) ? "ativo" : "")">Todos</a>
            <a asp-action="Historico" asp-controller="Cliente" asp-route-filtro="Concluido" class="pill @(filtroSelecionado == "Concluido" ? "ativo" : "")">Concluídos</a>
            <a asp-action="Historico" asp-controller="Cliente" asp-route-filtro="Agendado" class="pill @(filtroSelecionado == "Agendado" ? "ativo" : "")">Agendados</a>
            <a asp-action="Historico" asp-controller="Cliente" asp-route-filtro="Cancelado" class="pill @(filtroSelecionado == "Cancelado" ? "ativo" : "")">Cancelados</a>

         </div>
            <div class="lista">

                @foreach(Atendimento atendimento in atendimentos)
                {
                    <div class="item">
                        <img class="item-img" src="@atendimento.PacotesAtendimento[0].Imagem" alt="">
                        <div>
                            <h3 class="item-nome">@atendimento.PacotesAtendimento[0].Nome ...</h3>
                            <p class="item-meta">@atendimento.Situacao</p>
                        </div>
                        <span class="item-preco">R$@atendimento.Pagamento.Valor</span>
                        <div class="item-acao">

                            <form asp-controller="Atendimento" asp-action="Cancelar" method="post" onsubmit="return confirm('Tem certeza que deseja cancelar este agendamento?')">
                                <input type="hidden" name="id" value="@atendimento.IdConsulta"/>
                                <button type="submit" class="btn-cancelar">Cancelar Agendamento</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </main>
    </div>

   </section>