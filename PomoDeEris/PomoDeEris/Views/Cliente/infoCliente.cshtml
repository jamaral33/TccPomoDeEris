@{
    Layout = null;
    ViewData["Title"] = "Minhas informações - Pomo de Eris";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/infoCliente.css" asp-append-version="true"/>
</head>
<body>

    <!-- Barra superior -->
    <div class="barra-superior">
        <div class="barra-superior__interno">
            <span class="barra-superior__item">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z" /><circle cx="12" cy="9" r="2.5" /></svg>
            </span>
            <span class="barra-superior__item">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            </span>
        </div>
    </div>

    <!-- Header -->
    <header class="header">
        <div class="header__interno">
            <a class="logo" href="#">
                <span class="logo__titulo">Pomo de Eris</span>
                <span class="logo__subtitulo">Clínica Estética</span>
            </a>

            <nav class="nav">
                <a href="#" class="nav__item">Tratamentos</a>
                <a href="#" class="nav__item">Categorias</a>
                <a href="#" class="nav__item">Promoções</a>
                <a href="#" class="nav__item">Sobre</a>
                <a href="#" class="nav__item">Contato</a>
            </nav>

            <div class="header__icones">
                <button type="button" class="botao-icone" aria-label="Buscar">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" /></svg>
                </button>
                <button type="button" class="botao-icone" aria-label="Perfil">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7" /></svg>
                </button>
                <button type="button" class="botao-icone" aria-label="Carrinho">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 8h14l-1 12H6L5 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></svg>
                </button>
            </div>
        </div>
    </header>

    <main class="pagina">

        <!-- Menu lateral -->
        <aside class="menu-lateral">
            <h2 class="menu-lateral__nome"></h2>
            <p class="menu-lateral__desde"></p>

            <a href="#" class="menu-lateral__item">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                Histórico
            </a>
            <a href="#" class="menu-lateral__item menu-lateral__item--ativo">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20l4-1 11-11-3-3L5 16l-1 4z" /></svg>
                Minhas informações
            </a>

            <a href="#" class="menu-lateral__sair">Sair da conta</a>
        </aside>

        <section class="conteudo">
            <h1 class="conteudo__titulo">Minhas informações</h1>
            <p class="conteudo__subtitulo">Mantenha seus dados atualizados para agendamentos mais rápidos.</p>

            <form class="formulario" onsubmit="return false;">

                <!-- Dados pessoais -->
                <div class="cartao">
                    <h3 class="cartao__titulo">Dados pessoais</h3>
                    <p class="cartao__texto">Usamos essas informações para confirmar seus atendimentos.</p>

                    <div class="grade">
                        <div class="campo">
                            <label for="nome">Nome completo</label>
                            <input id="nome" type="text" />
                        </div>
                        <div class="campo">
                            <label for="email">E-mail</label>
                            <input id="email" type="email" />
                        </div>
                        <div class="campo">
                            <label for="telefone">Telefone / WhatsApp</label>
                            <input id="telefone" type="text" />
                        </div>
                        <div class="campo">
                            <label for="nascimento">Data de nascimento</label>
                            <input id="nascimento" type="text" />
                        </div>
                    </div>
                </div>

                <div class="cartao">
                    <h3 class="cartao__titulo">Segurança</h3>
                    <p class="cartao__texto">Escolha uma senha forte com letras, números e símbolos.</p>

                    <div class="grade">
                        <div class="campo">
                            <label for="senha">Nova senha</label>
                            <input id="senha" type="password" />
                        </div>
                        <div class="campo">
                            <label for="confirmar-senha">Confirmar nova senha</label>
                            <input id="confirmar-senha" type="password" />
                        </div>
                    </div>
                </div>

                <div class="acoes">
                    <button type="button" class="botao botao--perigo">Deletar Conta</button>
                    <div class="acoes__direita">
                        <button type="button" class="botao botao--contorno">Cancelar</button>
                        <button type="button" class="botao botao--primario">Salvar alterações</button>
                    </div>
                </div>
            </form>
        </section>
    </main>

    <!-- Acessbilidade -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>

    <script>
        window.addEventListener('load', function() {
            if (window.VLibras) {
                new window.VLibras.Widget('https://vlibras.gov.br/app');
            }
        });
    </script>

</body>
</html>