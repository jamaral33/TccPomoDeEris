@model Pacote
@section Styles{
    <link rel="stylesheet" href="~/css/pacote.css" />
}
<div class="secao-pacote">
    <section class="card-procedimentos">
        <h2 class="titulo-procedimentos">Procedimentos inclusos no pacote</h2>
        @foreach(var servico in Model.Servicos)
        {
            <details class="item-procedimento">
                <summary class="cabecalho-item">
                    <span>@servico.NomeServico</span>
                    <span class="icone-seta" aria-hidden="true"></span>
                </summary>
                <div class="conteudo-item">
                    <h3>@servico.NomeServico</h3>
                    <p>
                        @servico.DescricaoServico
                    </p>
                </div>
            </details>
        }

   
    </section>

    <article class="card-pacote">
        <img class="imagem-pacote" src="@Model.Imagem">

        <div class="info-pacote">
            <h2 class="titulo-pacote">@Model.Nome</h2>
            <p class="descricao-pacote">
               @Model.Descricao
            </p>
        </div>

        <div class="area-preco">
            <p class="preco-antigo">De: R$ @Model.Valor</p>
            <p class="preco-atual">
                Por R$ @((Model.Valor * (1 - Model.Desconto / 100.0)).ToString("N2"))
            </p>

            @using (Html.BeginForm("AdicionarItem", "Carrinho", FormMethod.Post))
            {

                <input type="hidden" name="id" value=@Model.IdPacote />
                <button class="botao-agendar" type="submit">+ Agendar</button>

            }
        </div>
    </article>
</div>

