@model List<Pacote>

@{
    ViewData["Title"] = "Seu carrinho";
    var total = Model.Sum(item => item.Valor);
    var tempoTotal = Model.Count * 60;
}
@section Styles {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/carrinhoDeCompra.css" asp-append-version="true">
}

<div class="cart-page">
  <div class="cart-page__title">
    <h1>Seu carrinho</h1>
    <p>Revise os tratamentos escolhidos antes de confirmar seu agendamento.</p>
  </div>

  <div class="cart-layout">

    <!-- LISTA DE ITENS -->
    <section class="cart-list-card">
      <ul class="cart-list" id="cart-list">
            @foreach(var item in Model)
            {
                <li class="cart-list-item">
                    <img src="@item.Imagem" alt="" class="cart-list-item__thumb">
                    <div class="cart-list-item__info">
                        <p class="cart-list-item__name">@item.Nome</p>
                        <span class="cart-list-item__duration">60 min</span>
                    </div>
                    <div class="cart-list-item__price">
                        @item.Valor
                    </div>
                        @using (Html.BeginForm("RemoverPacote", "Carrinho", FormMethod.Post))
                        {
                            <input type="hidden" name="id" value=@item.IdPacote />
                            <button class="cart-list-item__remove" aria-label="Remover item" type="submit">✕</button>
                        }
                    </li>
                }
        </ul>

      <div class="cart-empty-state" id="cart-empty-state" hidden>
        <p>Seu carrinho está vazio.</p>
        <span>Volte para o site e escolha os tratamentos ideais para você.</span>
      </div>

      <a href="@Url.Action("Index", "Home")#tratamentos" class="btn btn--dark">Continuar escolhendo tratamentos</a>
    </section>

    <!-- RESUMO -->
    <aside class="summary-card">
      <h2>Resumo do pedido</h2>

      <div class="summary-row">
        <span id="summary-count">@Model.Count tratamentos</span>
        <span id="summary-subtotal">R$ @total</span>
      </div>
      <div class="summary-row summary-row--discount">
        <span>Descontos</span>
        <span id="summary-discount">− R$ 0</span>
      </div>
      <div class="summary-row">
        <span>Duração total</span>
        <span id="summary-duration">@tempoTotal min</span>
      </div>

      <div class="summary-divider"></div>

      <div class="summary-total">
        <span>Total</span>
        <strong id="summary-total">R$ 0</strong>
      </div>

      <button class="btn btn--primary btn--block" id="confirm-btn">Confirmar agendamento</button>
    </aside>

  </div>
</div>

<div class="toast" id="toast"></div>

@section Scripts {
  <script src="~/js/carrinhoDeCompra.js" asp-append-version="true"></script>
}
