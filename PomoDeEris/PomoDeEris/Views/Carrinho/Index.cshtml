@model List<Pacote>

@{
    ViewData["Title"] = "Seu carrinho";
    Double total = 0;
    foreach(var pacote in Model)
    {
        total += pacote.Valor * pacote.Quantidade;
    }
    var tempoTotal = Model.Count * 60;
}
@section Styles {
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/carrinhoDeCompra.css" asp-append-version="true">
}

<div class="pagina-carrinho">
  <div class="carrinho-titulo">
    <h1>Seu carrinho</h1>
    <p>Revise os tratamentos escolhidos antes de confirmar seu agendamento.</p>
  </div>

  <div class="carrinho-conteudo">

    <!-- LISTA DE ITENS -->
    <section class="caixa-lista">
      <ul class="lista-carrinho" id="cart-list">
            @foreach(var item in Model)
            {
                <li class="item-carrinho">
                    <img src="@item.Imagem" alt="" class="item-imagem">
                    <div class="item-info">
                        <p class="item-nome">@item.Nome</p>
                        <span class="item-duracao">60 min</span>
                         <p class="item-nome">@item.Quantidade</p>
                        </div>
                    <div class="item-preco">
                        R$ @item.Valor
                    </div>
                        @using (Html.BeginForm("RemoverPacote", "Carrinho", FormMethod.Post))
                        {
                            <input type="hidden" name="id" value=@item.IdPacote />
                            <button class="item-remover" aria-label="Remover item" type="submit">✕</button>
                        }
                    </li>
                }
        </ul>

      <div class="lista-vazia" id="cart-empty-state" hidden>
        <p>Seu carrinho está vazio.</p>
        <span>Volte para o site e escolha os tratamentos ideais para você.</span>
      </div>

      <a href="@Url.Action("Index", "Home")#tratamentos" class="btn btn-escuro">Continuar escolhendo tratamentos</a>
    </section>

    <!-- RESUMO -->
    <aside class="resumo-carrinho">
      <h2>Resumo do pedido</h2>

      <div class="resumo-linha">
        <span id="summary-count">@Model.Count tratamentos</span>
        <span id="summary-subtotal">R$ @total</span>
      </div>
      <div class="resumo-linha resumo-linha-desconto">
        <span>Descontos</span>
        <span id="summary-discount">− R$ 0</span>
      </div>
      <div class="resumo-linha">
        <span>Duração total</span>
        <span id="summary-duration">@tempoTotal min</span>
      </div>

      <div class="resumo-divisoria"></div>

      <div class="resumo-valor-total">
        <span>Total</span>
        <strong id="summary-total">R$ @total</strong>
      </div>

    <a asp-action="ConfirmarHorario" asp-controller="Atendimento" class="btn btn-principal btn-largo" id="confirm-btn">Confirmar agendamento</a>
    </aside>

  </div>
</div>

<div class="toast" id="toast"></div>

@section Scripts {
  <script src="~/js/carrinhoDeCompra.js" asp-append-version="true"></script>
}
