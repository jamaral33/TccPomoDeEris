<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pomo De Eris</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="topbar">
        <div class="topbar-conteudo">
            <span>Unidade Jardins, São Paulo · Terça a Sábado, 9h às 19h</span>
            <span>WhatsApp (11) 4002-8922</span>
        </div>
    </div>

    <header class="header">
        <div class="header-conteudo">
              <a asp-controller="Home" asp-action="Index" class="logo">
            <span class="logo__title">Pomo de Eris</span>
            <span class="logo__subtitle">Clínica Estética</span>
        </a>
        <nav class="nav">
            <a href="@Url.Action("Index", "Home")#tratamentos">Tratamentos</a>
            <a href="@Url.Action("Index", "Home")#categorias">Categorias</a>
            <a href="@Url.Action("Index", "Home")#promocoes">Promoções</a>
            <a href="@Url.Action("Index", "Home")#sobre">Sobre</a>
            <a href="@Url.Action("Index", "Home")#contato">Contato</a>
        </nav>
        <div class="header__actions">
            <button class="icon-btn" id="search-toggle" aria-label="Buscar">
                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            </button>
            <a asp-controller="Home" asp-action="Login" class="icon-btn" aria-label="Minha conta">
                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            </a>
            <button class="icon-btn cart-btn" id="cart-toggle" aria-label="Carrinho">
                <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.5 3h2l2.7 12.4a2 2 0 0 0 2 1.6h8.6a2 2 0 0 0 2-1.6L22 7H6"/></svg>
                <span class="cart-count" id="cart-count">0</span>
            </button>
        </div>
        </div>
      
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <!-- RODAPÉ -->
    <footer class="footer" id="contato">
        <div class="footer-conteudo">
             <div class="footer-cima">
                <div class="footer__about">
                    <p class="footer__logo">Pomo de Eris</p>
                    <p>Clínica estética voltada a tratamentos faciais, corporais, massagens. Agendamento online simples e equipe clínica certificada.</p>
                </div>
                <div class="footer__col">
                    <h4>Atendimento</h4>
                    <a href="#">Como funciona</a>
                    <a href="#">Política de cancelamento</a>
                    <a href="#">Perguntas frequentes</a>
                    <a href="#">Trabalhe conosco</a>
                </div>
                <div class="footer__col">
                    <h4>Contato</h4>
                    <p>Rua dos Jardins, 482 — Jardins<br>São Paulo, SP</p>
                    <p>(11) 4002-8922<br>contato@pomodeeris.com.br</p>
                </div>
             </div>
             <div class="footer-baixo">
                <div class="footer__bottom">
                    <span>© 2026 Pomo de Eris. Todos os direitos reservados.</span>
                    <span><a href="#">Termos de uso</a> · <a href="#">Privacidade</a></span>
                </div>
             </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
