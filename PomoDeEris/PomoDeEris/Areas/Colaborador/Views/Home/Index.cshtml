@model PomoDeEris.Areas.Colaborador.Models.DashBoardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
}

<div class="page active" id="page-dashboard">

    <!-- INDICADORES -->
    <div class="kpi-grid">

        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon gold">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7">
                        <rect x="3" y="5" width="18" height="16" rx="2" />
                        <path d="M16 3v4M8 3v4M3 9h18" />
                    </svg>
                </div>
            </div>

            <h3>@Model.quantidadeConsultasHoje</h3>
            <p>Agendamentos hoje</p>
        </div>


        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon wine">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
            </div>

            <h3>R$ @Model.faturamentoDia</h3>
            <p>Receita do dia</p>
        </div>


        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon wine">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                    </svg>
                </div>
            </div>

            <h3>R$ @Model.faturamentoMes</h3>
            <p>Receita do mês</p>
        </div>


        <div class="kpi">
            <div class="kpi-top">
                <div class="kpi-icon green">
                    <svg viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                </div>
            </div>

            <h3>@Model.clientesCadastradosHoje</h3>
            <p>Clientes cadastrados este mês</p>
        </div>

    </div>


    <!-- DASHBOARD -->
    <div class="dash-grid">

        <!-- COLUNA ESQUERDA -->
        <div>

            <!-- AGENDAMENTOS -->
            <div class="card" style="margin-bottom:20px;">

                <div class="card-head">
                    <h3>
                        Agendamentos de @Convert.ToDateTime(ViewBag.DataSelecionada).ToString("dd/MM")
             </h3>

                    <a asp-area="Colaborador"
                       asp-controller="Agenda"
                       asp-action="Index"
                       class="btn btn-ghost btn-sm">
                        Ver todos
                    </a>
                </div>

                <div class="card-body" style="padding:0;">

                    <table class="mini-table">

                        <thead>
                            <tr>
                                <th>Hora</th>
                                <th>Cliente</th>
                                <th>Tratamento</th>
                                <th>Profissional</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Math.Min(5, Model.atendimentos.Count); i++) // Exibe no máximo 6 atendimentos
                            {
                                <tr>
                                    <td class="fw600">
                                        @Model.atendimentos[i].dataHora.ToString("HH:mm")
                                    </td>

                                    <td>
                                        @Model.atendimentos[i].cliente.Nome
                                    </td>

                                    <td>
                                        @Model.atendimentos[i].pacotesAtendimento[0].Nome

                                    </td>

                                    <td>
                                        @Model.atendimentos[i].funcionario.Nome
                                    </td>

                                    <td>
                                        <span class="status-pill confirmed">
                                            @Model.atendimentos[i].situacao
                                        </span>
                                    </td>
                                </tr>
                            }

                            
            

                        </tbody>

                    </table>

                </div>
            </div>


            <!-- PACOTES MAIS AGENDADOS -->
            <div class="card">

                <div class="card-head">
                    <h3>Pacotes mais agendados</h3>
                </div>

                <div class="card-body" style="padding:0;">

                    <table class="mini-table">

                        <thead>
                            <tr>
                                <th>Tratamento</th>
                                <th>Agendamentos</th>
                                <th>Receita</th>
                            </tr>
                        </thead>

                        <tbody>

                            
                                @foreach (var pacote in Model.vendasPacote)
                                {
                                    <tr>
                                        <td class="fw600">
                                            @pacote.NomePacote
                                        </td>

                                        <td>
                                            @pacote.Vendas
                                        </td>

                                        <td class="color-green fw600">
                                            R$ @pacote.Receita
                                        </td>
                                    </tr>
                                }
                            


                        </tbody>

                    </table>

                </div>
            </div>

        </div>


        <!-- COLUNA DIREITA -->
        <div>

            <!-- CALENDÁRIO -->
            <div class="card" style="margin-bottom:20px;">

                <div class="card-head">
                    <h3>Calendário</h3>
                </div>

                <div class="card-body">

                    <input type="hidden"
                           id="dataSelecionada"
                           value="@ViewBag.DataSelecionadaISO" />

                    <div id="calendario"></div>

                </div>
            </div>


            <!-- ATIVIDADES RECENTES -->
            <div class="card">

                <div class="card-head">
                    <h3>Atividade recente</h3>
                </div>

                <div class="card-body" style="padding:14px 20px;">

                    <div class="activity-list">

                            @foreach (var atividade in Model.atividadesRecentes)
                            {
                                <div class="activity-item">

                                    <span class="activity-dot gold"></span>

                                    <div class="activity-text">

                                        @if (atividade.Tipo == "novoAtendimento")
                                        {
                                            <text>
                                                Novo agendamento: @atividade.NomeCliente
                                                comprou @atividade.QuantidadePacotes pacotes
                                            </text>
                                        }
                                        else if (atividade.Tipo == "novoCliente")
                                        {
                                            <text>
                                                Novo Cliente: @atividade.NomeCliente se cadastrou
                                            </text>
                                        }

                                        <span class="time">

                                            @{
                                                var diferenca = DateTime.Now - atividade.DataEvento;
                                            }

                                            @if (diferenca.TotalMinutes < 1)
                                            {
                                                <text>agora</text>
                                            }
                                            else if (diferenca.TotalMinutes < 60)
                                            {
                                                <text>há @((int)diferenca.TotalMinutes) minutos</text>
                                            }
                                            else if (diferenca.TotalHours < 24)
                                            {
                                                <text>há @((int)diferenca.TotalHours) horas</text>
                                            }
                                            else
                                            {
                                                <text>
                                                    @atividade.DataEvento.ToString("dd/MM/yyyy HH:mm")
                                                </text>
                                            }

                                        </span>

                                    </div>

                                </div>
                            }
                        }

                    </div>

                </div>
            </div>

        </div>

    </div>

</div>
