@inject PomoDeEris.Repository.Contract.IServicoRepository ServicoRepository

@model Pacote

@section Scripts {
    <script src="~/js/formulariosAdm.js"></script>
}

<div class="pagina" id="paginaPacotes">
    <div class="cabecalho-secao">
        <div><h2>Atualizar pacote</h2><p>Preencha os dados do tratamento. Ele ficará visível no site assim que for publicado.</p></div>
        <button class="botao botao-secundario botao-pequeno" id="botaoLimparFormulario">Limpar formulário</button>
    </div>

    <div class="grade-formulario-pacote">
        
            <form method="post" asp-area="Colaborador" asp-controller="Pacote" asp-action="Atualizar" enctype="multipart/form-data">
                <input type="hidden" asp-for="IdPacote">
                <div>
                <div class="cartao-formulario">
                    <div class="secao-formulario">
                        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z" /></svg>Informações básicas</h4>
                        <div class="campo">
                            <label for="campoNome">Nome do pacote <span class="obrigatorio">*</span></label>
                            <input type="text" id="campoNome" placeholder="Ex: Limpeza de Pele Profunda" asp-for="Nome">
                        </div>
                        <div class="linha-campos">
                        </div>
                        <div class="campo">
                            <label for="campoDescricao">Descrição <span class="obrigatorio">*</span></label>
                            <textarea id="campoDescricao" rows="3" placeholder="Descreva o tratamento de forma clara e objetiva para as clientes." asp-for="Descricao"></textarea>
                            <p class="dica-campo">Máximo 150 caracteres. Aparece no card do site.</p>
                        </div>
                    </div>

                    <div class="secao-formulario">
                        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg>Preços</h4>
                        <div class="linha-campos">
                            <div class="campo">
                                <label for="campoValor">Preço de venda (R$) <span class="obrigatorio">*</span></label>
                                <input type="number" id="campoValor" placeholder="0,00" min="0" step="0.01" asp-for="Valor">
                            </div>
                            <div class="campo">
                                <label for="campoDesconto">Desconto % <span class="obrigatorio">*</span></label>
                                <input type="number" id="campoDesconto" placeholder="0%" min="0" step="1" asp-for="Desconto">
                            </div>
                        </div>
                    </div>
                    <div class="secao-formulario">
                        <div class="campo">
                            <button type="button" class="botao botao-secundario botao-pequeno" id="adicionarServico">Adicionar servico</button>

                            <label for="servicoInput">Serviço <span class="obrigatorio">*</span></label>

                            <div id="listaServicosSelecionados">
                                @foreach(var servico in Model.Servicos)
                                    {
                                    <div class="campo servico-item">
                                        <input type="text" id="servicoInput" class="servico-input" list="listaServicos"
                                               placeholder="Digite para pesquisar ou clique para ver..." value="@servico.NomeServico" data-id="@servico.IdServico" required>
                                        <input type="hidden" name="ServicosIds" class="servico-id" value="@servico.IdServico">

                                        <button type="button"
                                                class="botao botao-secundario botao-pequeno remover-servico"
                                                onclick="removerServico(this)">
                                            Remover
                                        </button>
                                    </div>
                                    }
                            </div>

                            <datalist id="listaServicos">
                                @foreach (var servico in ServicoRepository.ObterTodosServicos())
                                {
                                    <option value="@servico.NomeServico" data-id="@servico.IdServico"></option>
                                }
                            </datalist>
                        </div>
                    </div>
                    <div class="secao-formulario">
                        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>Imagem do tratamento</h4>
                        <div class="area-upload" id="areaUpload">
                            <input type="file" id="campoImagem" accept="image/*" name="arquivo">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                            <p>Arraste uma imagem ou <strong>clique para selecionar</strong></p>
                            <span>recomendado 800×600 px</span>
                        </div>
                    </div>
                </div>
            </div>
            <div style="margin-top:22px; display:flex; flex-direction:column; gap:10px;">
                <button class="botao botao-dourado" id="botaoPublicar" type="submit">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7" /></svg>
                    Atualizar
                </button>
            </div>
            </form>
    </div>

</div>
