@model List<Cliente>

<div class="pagina" id="page-clients">
    <div class="cabecalho-secao">
        <div>
            <h2>Histórico de clientes</h2>
            <p>Consulte o perfil e histórico completo de cada cliente.</p>
        </div>
        <button class="botao botao-dourado botao-pequeno" id="exportClientsBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            Exportar
        </button>
    </div>

    <div class="barra-ferramentas-clientes">
        <div class="caixa-busca">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input type="text" id="clientSearch" placeholder="Buscar por nome, e-mail ou telefone...">
        </div>
    </div>

    <table class="tabela-clientes" id="clientTable">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Telefone</th>
                <th>Último atend.</th>
                <th>Total (R$)</th>
                <th>Sessões</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="clientTbody">
            @foreach(var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nome</td>
                    <td>@cliente.Telefone</td>
                    <td>@ViewBag.UltimoAtendimento</td>
                    <td>@ViewBag.Total.ToString("N2")</td>
                    <td>@ViewBag.Sessoes</td>
                    <td>@cliente.Situacao</td>
                    <td><a asp-area="Colaborador" asp-controller="Atendimento" asp-action="Index" asp-route-cliente="@cliente.CPF"></a></td>
                </tr>
            }
        </tbody>
    </table>
</div>