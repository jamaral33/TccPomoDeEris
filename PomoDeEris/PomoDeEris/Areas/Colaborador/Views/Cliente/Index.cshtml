@model List<ClienteHistoricoViewModel>

<div class="pagina" id="page-clients">
    <div class="cabecalho-secao">
        <div>
            <h2>Histórico de clientes</h2>
            <p>Consulte o perfil e histórico completo de cada cliente.</p>
        </div>
    </div>

    <div class="barra-ferramentas-clientes">
        <form asp-controller="Cliente" asp-action="Index" method="get" id="formClienteFiltroIndex">
            <div class="caixa-busca">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <input type="text" id="clientSearch" placeholder="Buscar por nome" name="clientePesquisa" />
            </div>

            <button class="botao botao-dourado" id="botaoFiltrar" type="submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12l5 5L20 7" /></svg>
                Filtrar
            </button>
        </form>
    </div>

    <table class="tabela-clientes" id="clientTable">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Telefone</th>
                <th>Último atend.</th>
                <th>Total (R$)</th>
                <th>Sessões</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="clientTbody">
            @foreach (var historico in Model)
            {
                <tr>
                    <td>@historico.Cliente.Nome</td>
                    <td>@historico.Cliente.Telefone</td>
                    <td>@historico.UltimoAtendimento</td>
                    <td>R$ @historico.TotalGasto.ToString("N2")</td>
                    <td>@historico.Sessoes</td>
                    <td>@historico.Cliente.Situacao</td>
                    <td><a asp-area="Colaborador" asp-controller="Atendimento" asp-action="ListarAtendimentosCliente" asp-route-idCliente="@historico.Cliente.Id">Ver consultas</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>