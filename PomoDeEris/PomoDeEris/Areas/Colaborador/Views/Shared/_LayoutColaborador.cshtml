@using PomoDeEris.Libraries.Login
@inject LoginFuncionario loginFuncionario

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Pomo de Eris</title>

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/paginaAdm.css" asp-append-version="true">

    <!-- Vanilla Calendar Pro -->
    <link href="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/styles/index.css" rel="stylesheet">

</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">

        <div class="sb-brand">

            <img id="Logo"
                 src="~/images/logoPomoTransparente.png"
                 alt="Pomo de Eris">

            <div class="sb-brand-text">
                <span class="name">Pomo de Eris</span>
                <span class="tag">Painel de administração</span>
            </div>

        </div>


        <nav class="sb-nav">

            <span class="sb-section-label">Visão geral</span>
            <a asp-area="Colaborador"
               asp-controller="Atendimento"
               asp-action="Index"
               class="sb-item active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="8" height="9" rx="2"/>
                    <rect x="13" y="3" width="8" height="5" rx="2"/>
                    <rect x="13" y="11" width="8" height="10" rx="2"/>
                    <rect x="3" y="15" width="8" height="6" rx="2"/>
                </svg>
                Dashboard
            </a>

            <span class="sb-section-label">Operação</span>

            <a asp-area="Colaborador"
               asp-controller="Pacote"
               asp-action="Index"
               class="sb-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Adicionar pacote
            </a>

            <a asp-area="Colaborador"
               asp-controller="Agenda"
               asp-action="Index"
               class="sb-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M16 3v4M8 3v4M3 9h18"/>
                </svg>
                Cronogramas
                <span class="sb-badge" id="pendingBadge">3</span>
            </a>

            <a asp-area="Colaborador"
               asp-controller="Cliente"
               asp-action="Index"
               class="sb-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/>
                    <circle cx="10" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Histórico de clientes
            </a>

            <span class="sb-section-label">Configurações</span>

            <a asp-area="Colaborador"
               asp-controller="Configuracao"
               asp-action="Index"
               class="sb-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>
                </svg>
                Configurações
            </a>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="sb-item"
               style="color:rgba(255,250,244,.7);">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M3 12L12 3l9 9"/>
                    <path d="M9 21V12h6v9"/>
                </svg>
                Ver site
            </a>

        </nav>


        <!-- USUÁRIO -->
        <div class="sb-footer">

            <div class="sb-user">

                <div class="sb-avatar">AL</div>

                <div class="sb-user-info">
                    <div class="nm">Administrador</div>
                    <div class="role">Administradora</div>
                </div>

                <button class="sb-logout" title="Sair">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>

            </div>

        </div>

    </aside>


    <!-- CONTEÚDO PRINCIPAL -->
    <div class="main" id="mainArea">

        <header class="topbar">

            <h1 class="topbar-title">
                @ViewData["PageTitle"]
            </h1>


        </header>


        <!-- CONTEÚDO DA VIEW -->
        <main>
            @RenderBody()
        </main>

    </div>


    <!-- JAVASCRIPT -->
    <script src="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/index.js"></script>

    <script src="~/js/calendarioAdm.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
