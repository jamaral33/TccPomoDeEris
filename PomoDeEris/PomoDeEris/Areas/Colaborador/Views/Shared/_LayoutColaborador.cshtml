@using PomoDeEris.Libraries.Login
@inject LoginFuncionario loginFuncionario

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - Pomo de Eris</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/paginaAdm.css" asp-append-version="true">

    <link href="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/styles/index.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/vanilla-calendar-pro/index.js" defer></script>

</head>

<body>

    <!-- SIDEBAR -->
    <aside class="menu-lateral" id="menuLateral">

        <div class="marca-menu">

            <img id="logoMarca"
                 src="~/images/logoPomoTransparente.png"
                 alt="Pomo de Eris">

            <div class="texto-marca">
                <span class="nome-sistema">Pomo de Eris</span>
                <span class="subtitulo-sistema">Painel de administração</span>
            </div>

        </div>


        <nav class="navegacao-menu">

            <span class="titulo-secao-menu">Visão geral</span>
            <a asp-area="Colaborador"
               asp-controller="Atendimento"
               asp-action="Index"
               class="item-menu ativo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="3" width="8" height="9" rx="2"/>
                    <rect x="13" y="3" width="8" height="5" rx="2"/>
                    <rect x="13" y="11" width="8" height="10" rx="2"/>
                    <rect x="3" y="15" width="8" height="6" rx="2"/>
                </svg>
                Dashboard
            </a>

            <span class="titulo-secao-menu">Operação</span>

            <a asp-area="Colaborador"
               asp-controller="Pacote"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Gerenciar Pacotes
            </a>
            <a asp-area="Colaborador"
               asp-controller="Servico"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                Gerenciar Serviços
            </a>

            <a asp-area="Colaborador"
               asp-controller="Atendimento"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="5" width="18" height="16" rx="2"/>
                    <path d="M16 3v4M8 3v4M3 9h18"/>
                </svg>
                Cronogramas
            </a>

            <a asp-area="Colaborador"
               asp-controller="Agenda"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M16 3v4M8 3v4M3 9h18" />
                </svg>
                Gerenciar Horários
            </a>

            <a asp-area="Colaborador"
               asp-controller="Cliente"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/>
                    <circle cx="10" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                Histórico de clientes
            </a>

            @if (loginFuncionario.GetFuncionario().Cargo == "Administrador")
            {
                <a asp-area="Colaborador"
                   asp-controller="Funcionario"
                   asp-action="Index"
                   class="item-menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Gerenciar funcionários
                </a>
            }
            

            <span class="titulo-secao-menu">Configurações</span>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="item-menu">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M3 12L12 3l9 9"/>
                    <path d="M9 21V12h6v9"/>
                </svg>
                Ver site
            </a>

        </nav>


        <!-- USUÁRIO -->
        <div class="rodape-menu">

            <div class="usuario-menu">

                <div class="avatar-usuario"></div>

                <div class="dados-usuario">
                    <div class="nome-usuario">@loginFuncionario.GetFuncionario().Nome</div>
                    <div class="cargo-usuario">@loginFuncionario.GetFuncionario().Cargo</div>
                </div>

                <button class="botao-sair" title="Sair">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                </button>

            </div>

        </div>

    </aside>


    <!-- CONTEÚDO PRINCIPAL -->
    <div class="conteudo-principal" id="areaPrincipal">

        <header class="barra-superior">

            <h1 class="titulo-barra-superior">
                @ViewData["PageTitle"]
            </h1>


        </header>


        <!-- CONTEÚDO DA VIEW -->
        <main>
            @RenderBody()
        </main>

    </div>



    @await RenderSectionAsync("Styles", required: false);
    @await RenderSectionAsync("Scripts", required: false);
</body>
</html>
